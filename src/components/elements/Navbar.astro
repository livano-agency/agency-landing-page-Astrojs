---
const links = [
  ['/services', 'Services'], ['/about', 'About Us'], ['/features', 'Features'],
  ['/case-studies', 'Case Studies'], ['/blog', 'Blog'], ['/contact', 'Contact'],
];
const path = Astro.url.pathname.replace(/\/$/, '');
---
<header class="header">
  <div class="container navbar">
    <a class="logo" href="/" aria-label="LaunchLegit home">
      <img class="site-logo" src="/logos/logo-ll.png" alt="" width="44" height="44" />
      <span class="logo-wordmark">LaunchLegit</span>
    </a>
    <nav id="primary-nav" class="nav" aria-label="Primary navigation">
      {links.map(([href, label]) => <a href={href} class:list={{ active: path === href || path.startsWith(href + '/') }} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="btn btn-primary header-cta" href="/#calendly-section">Book a call</a>
      <button class="icon-btn theme-btn" type="button" aria-label="Switch to dark theme">☾</button>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">☰</button>
    </div>
  </div>
</header>
