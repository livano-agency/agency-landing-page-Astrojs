---
import type { SanityImageSource } from '@sanity/image-url';
import { imageUrl } from '../../lib/sanity/image';
import { imagePresentation } from '../../lib/sanity/image-presentation';
interface Props {
  image?: SanityImageSource | null;
  src?: string;
  alt: string;
  displayStyle?: string | null;
  width?: number;
  height?: number;
  className?: string;
  eager?: boolean;
}
const { image, src, alt, displayStyle, width = 1200, height = 630, className, eager = false } = Astro.props;
const presentation = imagePresentation(displayStyle);
const url = src || (image ? imageUrl(image, width, height, displayStyle) : undefined);
---
{url && <div class:list={['cms-image w-full overflow-hidden bg-box-bg', className]} data-display-style={displayStyle || 'cover'} style={`aspect-ratio: ${width} / ${height}; padding: ${presentation.padded ? '1.5rem' : '0'};`}>
  <img src={url} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" style={`display: block; width: 100%; height: 100%; object-fit: ${presentation.fit};`} />
</div>}
