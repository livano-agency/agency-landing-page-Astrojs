---
import { PortableText } from 'astro-portabletext';
import type { BlogPost } from '../../lib/sanity/content.server';
import PortableImage from './PortableImage.astro';
import PortableLink from './PortableLink.astro';
interface Props { value: BlogPost['body'] }
const { value } = Astro.props;
// The renderer builds mark/list trees in place. Keep cached query data pristine.
const body = structuredClone(value ?? []);
---
<div class="article-body text-heading-2">
  <PortableText value={body} components={{ type: { contentImage: PortableImage }, mark: { link: PortableLink } }} />
</div>
<style>
  .article-body { line-height: 1.8; overflow-wrap: anywhere; }
  .article-body :global(p), .article-body :global(ul), .article-body :global(ol) { margin-block: 1.25rem; }
  .article-body :global(h2) { margin: 3rem 0 1rem; font-size: 1.5rem; font-weight: 700; line-height: 1.3; color: rgb(var(--heading-1)); }
  .article-body :global(h3) { margin: 2rem 0 .75rem; font-size: 1.25rem; font-weight: 600; line-height: 1.4; }
  .article-body :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .article-body :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .article-body :global(li) { margin-block: .5rem; }
  .article-body :global(a) { color: #4f46e5; text-decoration: underline; text-underline-offset: 3px; }
  :global(.dark) .article-body :global(a) { color: #a5b4fc; }
  .article-body :global(blockquote) { border-left: 3px solid currentColor; padding-left: 1.5rem; font-style: italic; margin-block: 2rem; }
  .article-body :global(figure) { margin-block: 2rem; }
  .article-body :global(img) { width: 100%; height: auto; border-radius: 1rem; }
  .article-body :global(figcaption) { font-size: .875rem; text-align: center; margin-top: .5rem; }
</style>
