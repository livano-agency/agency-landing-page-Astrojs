---
import type { BlogPost } from '../../lib/sanity/content.server';
import { imageUrl } from '../../lib/sanity/image';
import { safeHref } from '../../lib/sanity/content-utils';
interface Props { author: BlogPost['author'] }
const { author } = Astro.props;
const hasAuthor = Boolean(author?.name?.trim());
const name = hasAuthor ? author!.name : 'Rabii Babou';
const bio = hasAuthor
  ? [author?.role, author?.shortBio].filter(Boolean).join(' ')
  : 'Head of growth for Livano Agency. Rabii helps e-commerce brands scale through TikTok Shop, affiliates, and influencers with proven systems and playbooks.';
const founderPortrait = name === 'Rabii Babou' ? '/images/founder_rabii.jpg'
  : name === 'Lokman Sahnoun' ? '/images/founder_lokman.jpeg' : undefined;
const portrait = hasAuthor
  ? (author?.profileImage?.asset ? imageUrl(author.profileImage, 144, 144) : founderPortrait)
  : '/images/founder_rabii.jpg';
const configuredUrl = safeHref(author?.ctaUrl);
const isLegacyHomepage = configuredUrl && /^https?:\/\/(?:www\.)?launchlegit\.com\/?(?:#calendly-section)?$/i.test(configuredUrl);
const ctaUrl = isLegacyHomepage ? '/#calendly-section' : configuredUrl || '/#calendly-section';
const ctaText = author?.ctaButtonText?.trim() || (hasAuthor ? 'Book a Call' : 'Book a Call with Rabii');
---
<aside aria-label={hasAuthor ? 'About the author' : 'Book a call with Livano'} class="mt-12 rounded-xl border border-gray-700 bg-gray-900 p-6">
  <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
    {portrait && <img src={portrait} alt={author?.profileImage?.alt || name} width="72" height="72" loading="lazy" class="h-[72px] w-[72px] shrink-0 rounded-full border border-gray-600 object-cover" />}
    <div class="min-w-0">
      <h2 class="text-lg font-semibold leading-6 text-white">{name}</h2>
      {bio && <p class="mt-0.5 text-[13px] leading-[19px] text-gray-300">{bio}</p>}
      <a href={ctaUrl} class="mt-2.5 inline-flex items-center gap-1 rounded-md bg-white px-4 py-2 text-sm font-medium leading-5 text-gray-950 transition-colors hover:bg-gray-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
        {ctaText}<span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</aside>
