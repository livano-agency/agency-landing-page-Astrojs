---
import Layout from '../layouts/Layout.astro';
import { getCaseStudies } from '../lib/sanity/content.server';
import { formatDate, readingTime } from '../lib/sanity/content-utils';
import CmsImage from '../components/content/CmsImage.astro';

const posts = await getCaseStudies();
---
<Layout title="Case Studies" description="Explore the challenges, work, and results behind our clients’ U.S. TikTok Shop launches.">
  <section class="page-hero"><div class="container reveal"><div class="breadcrumb"><a href="/">Home</a> / Case Studies</div><span class="section-kicker">Case Studies</span><h1>Cross-border launches, handled from setup to platform approval.</h1><p class="lead">Explore the challenges, work, and results behind our clients’ U.S. TikTok Shop launches.</p></div></section>
  <section id="case-studies"><div class="container"><div class="grid-2">
    {posts.map(post => <article class="card reveal content-card" data-cms-card>
      <a href={`/case-studies/${post.slug}`} tabindex="-1" aria-hidden="true"><CmsImage image={post.coverImage} src={post.localCoverImage} alt={post.coverImage?.alt || post.localCoverAlt || post.title} displayStyle={post.coverImage?.displayStyle} width={1000} height={500} className="card-cover" /></a>
      <div class="post-meta">{post.category && <span class="tag">{post.category}</span>}<time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time><span>{readingTime(post.body)}</span></div>
      <a href={`/case-studies/${post.slug}`}><h3>{post.title}</h3></a>
      {post.author?.name && <p class="byline">By {post.author.name}</p>}
      <p class="muted">{post.description}</p><a class="card-link" href={`/case-studies/${post.slug}`}>Read case study →</a>
    </article>)}

  </div>{posts.length === 0 && <p class="muted">More client stories are coming soon.</p>}</div></section>
  <section class="surface-alt"><div class="container"><div class="cta-band reveal"><div><h2>Have a similar cross-border challenge?</h2><p>Tell us where your business is today and we’ll map the setup path.</p></div><a class="btn btn-primary" href="/#calendly-section">Book a call</a></div></div></section>
</Layout>
