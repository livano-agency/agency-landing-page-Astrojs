---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Title from "../components/shared/Title.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import { getCaseStudies } from '../lib/sanity/content.server';
import { formatDate, readingTime } from '../lib/sanity/content-utils';
import CmsImage from '../components/content/CmsImage.astro';
const posts = await getCaseStudies();
---

<Layout title="Case Studies" description="See how LaunchLegit helps international brands launch and grow on TikTok Shop in the United States.">

<section id="case-studies" class="relative pt-32 lg:pt-36 pb-20 mb-0">
      <Container className="space-y-16">
        <div class="text-center max-w-2xl mx-auto space-y-4">
          <Title>Case Studies</Title>
          <Paragraph>Explore the challenges, work, and results behind our clients’ U.S. TikTok Shop launches.</Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-10 max-w-5xl mx-auto mt-10">
          {posts.map((post) => (
            <div class="bg-box-bg border border-box-border rounded-xl overflow-hidden shadow-md hover:shadow-xl transition">
              <a href={`/case-studies/${post.slug}`}>
                <CmsImage image={post.coverImage} src={post.localCoverImage} alt={post.coverImage?.alt || post.localCoverAlt || post.title} displayStyle={post.coverImage?.displayStyle} width={1000} height={500} className="h-56" />
              </a>
              <div class="p-6 space-y-3">
                <a href={`/case-studies/${post.slug}`}>
                  <h3 class="text-2xl font-bold text-heading-1 hover:underline">{post.title}</h3>
                </a>
                <div class="text-sm text-heading-3 flex flex-wrap gap-2">
                  <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time><span>•</span><span>{readingTime(post.body)}</span>{post.category && <><span>•</span><span>{post.category}</span></>}
                </div>
                {post.author?.name && <p class="text-sm text-heading-3">By {post.author.name}</p>}
                <p class="text-sm text-heading-3">{post.description}</p>
                <a href={`/case-studies/${post.slug}`} class="text-primary font-medium text-sm hover:underline inline-block mt-2">
                  Read more →
                </a>
              </div>
            </div>
          ))}
        </div>
        {posts.length === 0 && <p class="text-center text-heading-3">More client stories are coming soon.</p>}
      </Container>
    </section>
  </Layout>
