---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ArticleBody from '../../components/content/ArticleBody.astro';
import AuthorCard from '../../components/content/AuthorCard.astro';
import CmsImage from '../../components/content/CmsImage.astro';
import { getCaseStudies } from '../../lib/sanity/content.server';
import { formatDate, readingTime } from '../../lib/sanity/content-utils';
import { imageUrl } from '../../lib/sanity/image';

export const getStaticPaths = (async () => {
  const posts = await getCaseStudies();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props;
const socialImage = post.localCoverImage || (post.coverImage?.asset ? imageUrl(post.coverImage, 1200, 630, post.coverImage.displayStyle) : undefined);
---
<Layout title={post.seoTitle || post.title} description={post.seoDescription || post.description} image={socialImage} ogType="article" publishedAt={post.publishedAt}>
  <section class="page-hero"><div class="container article">
    <div class="breadcrumb"><a href="/">Home</a> / <a href="/case-studies">Case Studies</a></div>
    <div class="post-meta">{post.category && <span class="tag">{post.category}</span>}<time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time><span>{readingTime(post.body)}</span>{post.author?.name && <span>By {post.author.name}</span>}</div>
    <h1>{post.title}</h1><p class="lead">{post.description}</p>
  </div></section>
  <section><article class="container article">
    <CmsImage image={post.coverImage} src={post.localCoverImage} alt={post.coverImage?.alt || post.localCoverAlt || post.title} displayStyle={post.coverImage?.displayStyle} className="article-cover" eager />
    <ArticleBody value={post.body} />
    <AuthorCard author={post.author} />
    <div class="actions"><a class="btn btn-secondary" href="/case-studies">← All case studies</a><a class="btn btn-primary" href="/#calendly-section">Book a call</a></div>
  </article></section>
</Layout>
