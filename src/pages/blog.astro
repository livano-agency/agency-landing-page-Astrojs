---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Title from "../components/shared/Title.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import { getBlogPosts } from '../lib/sanity/content.server';
import { formatDate, readingTime } from '../lib/sanity/content-utils';
import { imageUrl } from '../lib/sanity/image';
const posts = await getBlogPosts();
---

<Layout title="Blog" description="Explore guides, insights, and TikTok Shop strategies from LaunchLegit.">

<section id="blog" class="relative pt-32 lg:pt-36 pb-20 mb-0">
      <Container className="space-y-16">
        <div class="text-center max-w-2xl mx-auto space-y-4">
          <Title>All Blog Posts</Title>
          <Paragraph>Explore guides, insights, and TikTok Shop strategies.</Paragraph>
        </div>

        <div class="grid md:grid-cols-2 gap-10 max-w-5xl mx-auto mt-10">
          {posts.map((post) => (
            <div class="bg-box-bg border border-box-border rounded-xl overflow-hidden shadow-md hover:shadow-xl transition">
              <a href={`/blog/${post.slug}`}>
                {(post.coverImage?.asset || post.localCoverImage) && <img src={post.localCoverImage || imageUrl(post.coverImage!, 1000, 500)} alt={post.coverImage?.alt || post.localCoverAlt || post.title} width="1000" height="500" loading="lazy" decoding="async" class="w-full h-56 object-cover" />}
              </a>
              <div class="p-6 space-y-3">
                <a href={`/blog/${post.slug}`}>
                  <h3 class="text-2xl font-bold text-heading-1 hover:underline">{post.title}</h3>
                </a>
                <div class="text-sm text-heading-3 flex flex-wrap gap-2">
                  <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time><span>•</span><span>{readingTime(post.body)}</span><span>•</span><span>{post.category}</span>
                </div>
                <p class="text-sm text-heading-3">{post.description}</p>
                <a href={`/blog/${post.slug}`} class="text-primary font-medium text-sm hover:underline inline-block mt-2">
                  Read more →
                </a>
              </div>
            </div>
          ))}
        </div>
        {posts.length === 0 && <p class="text-center text-heading-3">New articles are on the way. Check back soon.</p>}
      </Container>
    </section>
  </Layout>

