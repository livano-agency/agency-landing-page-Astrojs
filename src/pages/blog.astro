---
import Layout from '../layouts/Layout.astro';
import { getBlogPosts } from '../lib/sanity/content.server';
import { formatDate, readingTime } from '../lib/sanity/content-utils';
import CmsImage from '../components/content/CmsImage.astro';
const posts = await getBlogPosts();
---
<Layout title="Blog" description="Insights on U.S. market entry, cross-border e-commerce and TikTok Shop setup.">
  <section class="page-hero"><div class="container reveal"><div class="breadcrumb"><a href="/">Home</a> / Blog</div><span class="section-kicker">Blog</span><h1>Practical guides for international TikTok Shop sellers.</h1><p class="lead">Insights on U.S. market entry, cross-border e-commerce and TikTok Shop setup.</p></div></section>
  <section id="blog"><div class="container"><div class="grid-3">
    {posts.map(post => <article class="card reveal content-card" data-cms-card>
      <a href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true"><CmsImage image={post.coverImage} src={post.localCoverImage} alt={post.coverImage?.alt || post.localCoverAlt || post.title} displayStyle={post.coverImage?.displayStyle} width={1000} height={500} className="card-cover" /></a>
      <div class="post-meta">{post.category && <span class="tag">{post.category}</span>}<time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time><span>{readingTime(post.body)}</span></div>
      <a href={`/blog/${post.slug}`}><h3>{post.title}</h3></a>
      {post.author?.name && <p class="byline">By {post.author.name}</p>}
      <p class="muted">{post.description}</p><a class="card-link" href={`/blog/${post.slug}`}>Read article →</a>
    </article>)}
  </div>{posts.length === 0 && <p class="muted">New articles are on the way. Check back soon.</p>}</div></section>
  <section class="surface-alt"><div class="container"><div class="cta-band reveal"><div><h2>Need a launch plan, not another checklist?</h2><p>Tell us where your business is today and we’ll map the setup path.</p></div><a class="btn btn-primary" href="/#calendly-section">Book a call</a></div></div></section>
</Layout>
