---
import Footer from '../components/elements/Footer.astro';
import Navbar from '../components/elements/Navbar.astro';
import '../styles/site.css';
export interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedAt?: string;
  noindex?: boolean;
}
const { title, description = 'LaunchLegit helps international brands and creators launch and run a U.S. TikTok Shop.', image = '/images/dev-with-c-1.webp', ogType = 'website', publishedAt, noindex = false } = Astro.props;
const pageTitle = `${title} | LaunchLegit`;
const site = Astro.site || new URL('https://launchlegit.com');
const canonical = new URL(Astro.url.pathname, site).href;
const socialImage = new URL(image, site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#172554" />
    <link rel="icon" type="image/png" href="/logos/logo-ll.png" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('ll-theme') || localStorage.getItem('appTheme');
        const dark = theme === 'dark' || (!theme && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', dark);
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Navbar />
    <main id="main"><slot /></main>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
