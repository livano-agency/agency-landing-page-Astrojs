{
  "name": "launchlegit-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "login": "SANITY_CLI_CALLBACK_PORT=0 sanity login",
    "check": "tsc --noEmit",
    "schema:deploy": "sanity schemas deploy",
    "typegen": "sanity schemas extract --force --enforce-required-fields && sanity typegen generate",
    "content:check": "sanity exec scripts/import-content.ts --with-user-token",
    "content:import": "sanity exec scripts/import-content.ts --with-user-token -- --write",
    "content:validate": "sanity documents validate"
  },
  "dependencies": {
    "@sanity/client": "^8.5.0",
    "@sanity/icons": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.12.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
